Options -Indexes
RewriteEngine On

# ── Redireciona links quebrados do WordPress para a home ──────────────────────
# Padrão /YYYY/MM/DD/slug/ (posts WordPress)
RewriteRule ^20[0-9]{2}/[0-9]{2}/[0-9]{2}/.+/?$ / [R=301,L]

# Páginas admin/login do WordPress (segurança)
RewriteRule ^wp-admin/?$ / [R=301,L]
RewriteRule ^wp-login\.php$ / [R=301,L]
RewriteRule ^wp-content/ - [F,L]

# ── Canonical HTTPS (força HTTPS) ────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── Canonical sem www (evita conteúdo duplicado no Google) ───────────────────
RewriteCond %{HTTP_HOST} ^www\.ferreiraodontologiaesaude\.com\.br [NC]
RewriteRule ^(.*)$ https://ferreiraodontologiaesaude.com.br/$1 [R=301,L]

# ── Barra final canonical (remove trailing slash desnecessária) ──────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# ── Cache de performance ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html             "access plus 1 hour"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
</IfModule>

# ── Compressão Gzip (carregamento mais rápido) ────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
